# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and temporary files
.pytest_cache/
*.swp
*.swo
*~
.DS_Store
tmp/
output/

# Environments
.venv/
env/
venv/
ENV/

# Large archives and binaries
*.zip
*.pt
*.pth
stage-2-dl/.runtime/
stage-2-dl/dl/checkpoints/pretrained/
stage-2-dl/dl/checkpoints/validated_v3/*.pt
stage-2-dl/dl/checkpoints/*.pt

# Large generated v2 binary pathology tiles (reproducible via pipeline.py)
stage-2-dl/data-engineering/data/v2/raw/images/*.png
stage-2-dl/data-engineering/data/v2/processed/pathology_tiles/*/*.png
!stage-2-dl/data-engineering/data/v2/processed/pathology_tiles/*/.gitkeep

# Integration Test Databases and Scratch Files
.pytest_temp/
.pytest_tmp/
*.db
*.db-wal
*.db-shm
stage-3-nlp-slm/scratch/

# Environment variables and secrets
.env
*.env
stage 5 Gen-AI/**/.env
