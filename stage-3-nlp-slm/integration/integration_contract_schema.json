{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precision-oncology.internal/schemas/stage3-stage4-contract-v1.0.0.json",
  "title": "Stage3ToStage4IntegrationContract",
  "description": "Standardized output contract from Stage 3 Clinical NLP to Stage 4 Treatment Optimization Engine.",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "patient_id",
    "inference_timestamp",
    "model_version",
    "ner_model_version",
    "triage_urgency",
    "toxicity_hazard",
    "clinical_entities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version string of the contract specification."
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the clinical note or transcript."
    },
    "patient_id": {
      "type": "string",
      "minLength": 1,
      "description": "De-identified patient construct identifier."
    },
    "inference_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of inference generation."
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier and version of the triage/hazard classification model."
    },
    "ner_model_version": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier and version of the clinical entity extraction tagger."
    },
    "triage_urgency": {
      "type": "object",
      "required": ["predicted_class", "confidence"],
      "additionalProperties": false,
      "properties": {
        "predicted_class": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "class_probabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    },
    "toxicity_hazard": {
      "type": "object",
      "required": ["predicted_class", "confidence"],
      "additionalProperties": false,
      "properties": {
        "predicted_class": {
          "type": "string",
          "enum": [
            "NONE",
            "HEMATOLOGIC",
            "HEPATIC",
            "RENAL",
            "CARDIAC",
            "PULMONARY",
            "NEUROPATHIC",
            "DERMATOLOGIC"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "class_probabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    },
    "clinical_entities": {
      "type": "array",
      "description": "List of extracted oncology entities with character offsets and polarity attributions.",
      "items": {
        "type": "object",
        "required": ["start", "end", "label", "text"],
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "description": "0-indexed character start position in normalized text."
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "description": "0-indexed character end position (exclusive)."
          },
          "label": {
            "type": "string",
            "enum": ["GENE_MUTATION", "DRUG_NAME", "DOSAGE", "ADVERSE_EVENT"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "polarity": {
            "type": "string",
            "enum": ["AFFIRMED", "NEGATED", "HISTORICAL", "RESOLVED"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    },
    "raw_text_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the normalized input text for tamper detection."
    },
    "integration_metadata": {
      "type": "object",
      "description": "Optional runtime telemetry dictionary.",
      "additionalProperties": true
    }
  }
}
